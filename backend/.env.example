# Optional. Default is a SQLite file next to the app (fine locally, and on Render Free where it is ephemeral).
# Only set an absolute path if you deliberately attach a persistent disk (paid), e.g. sqlite:////var/data/roamly.db
DATABASE_URL=sqlite:///./roamly.db
# Comma-separated list of deployed frontend origins allowed by CORS (the Vercel URL)
CORS_ORIGINS=http://localhost:3000
